export struct MediaTile {
    id: string,
    title: string,
    subtitle: string,
    poster: image,
    kind: string,
}

component ShelfTile inherits Rectangle {
    in property <MediaTile> media;
    in property <bool> selected;
    callback activated();
    border-radius: 9px;
    border-width: selected ? 3px : 1px;
    border-color: selected ? #4de1cb : #2e4353;
    background: selected ? #243b49 : #12232f;
    clip: true;
    Image {
        source: root.media.poster;
        image-fit: cover;
        width: parent.width;
        height: parent.height;
    }
    Rectangle {
        y: parent.height - 56px;
        height: 56px;
        width: parent.width;
        background: #142632;
        Text {
            x: 10px;
            y: 7px;
            width: parent.width - 20px;
            height: 23px;
            text: root.media.title;
            font-size: 14px;
            font-weight: 700;
            color: #f1f5f8;
            overflow: elide;
        }
        Text {
            x: 10px;
            y: 31px;
            width: parent.width - 20px;
            height: 17px;
            text: root.media.subtitle;
            font-size: 10px;
            color: #96aebc;
            overflow: elide;
        }
    }
    TouchArea { clicked => {root.activated();} }
}

export component AuroraWindow inherits Window {
    title: "AuroraTV 3.0 — Rust";
    width: 1280px;
    height: 720px;
    background: #09121c;

    in-out property <[string]> tabs: ["HOME", "LIVE TV", "MOVIES", "TV SHOWS", "MY LIST", "SEARCH", "EDIT LIBRARY"];
    in-out property <[MediaTile]> first-row: [];
    in-out property <[MediaTile]> second-row: [];
    in-out property <int> selected-tab: 0;
    in-out property <int> selected-index: -1;
    in-out property <string> hero-title: "Your entertainment, organized.";
    in-out property <string> hero-subtitle: "Add your IPTV provider to begin browsing.";
    in-out property <string> section-title: "YOUR IPTV LIBRARY";
    in-out property <string> status-text: "AuroraTV 3.0 / Rust engine";
    in-out property <string> guide-state: "EPG idle";
    in-out property <bool> login-visible: true;
    in-out property <bool> details-visible: false;
    in-out property <string> details-title: "";
    in-out property <string> details-overview: "";
    in-out property <string> details-cast: "";
    in-out property <string> details-related: "";
    in-out property <string> settings-key: "";
    in-out property <bool> search-visible: false;

    callback switch-tab(int);
    callback move-selection(string);
    callback activate-selection();
    callback open-item(int);
    callback play-featured();
    callback details-featured();
    callback favorite-selected();
    callback go-back();
    callback search-library(string);
    callback connect-xtream(string,string,string);
    callback connect-m3u(string);
    callback save-tmdb-key(string);

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 76px;
        background: #101d29;
        Text {
            x: 28px;
            y: 19px;
            width: 165px;
            height: 38px;
            text: "AURORA";
            color: #efffff;
            font-size: 28px;
            font-weight: 900;
            letter-spacing: 1.4px;
        }
        Text {
            x: 158px;
            y: 25px;
            width: 38px;
            text: "TV";
            font-size: 14px;
            font-weight: 700;
            color: #4de1cb;
        }
        HorizontalLayout {
            x: 221px;
            y: 16px;
            height: 43px;
            width: parent.width - 245px;
            spacing: 8px;
            for tab[index] in root.tabs: Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                border-width: root.selected-tab == index && root.selected-index == -1 ? 2px : 0px;
                border-color: #4de1cb;
                background: root.selected-tab == index ? #23404c : transparent;
                Text {
                    text: tab;
                    font-size: 12px;
                    font-weight: 700;
                    color: root.selected-tab == index ? #ffffff : #a5b5c3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => {root.switch-tab(index);} }
            }
        }
    }

    if !root.details-visible && !root.login-visible: Rectangle {
        x: 26px; y: 92px;
        width: parent.width - 52px;
        height: 185px;
        background: #162734;
        border-radius: 12px;
        Rectangle {
            x: 0; y: 0; width: 5px; height: parent.height;
            background: #4de1cb;
        }
        Text {
            x: 24px; y: 18px;
            height: 19px;
            text: "NOW IN YOUR LIBRARY";
            color: #4de1cb;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
        }
        Text {
            x: 24px; y: 44px;
            width: parent.width - 55px;
            height: 49px;
            text: root.hero-title;
            color: #f8fbfd;
            font-size: 34px;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            x: 24px; y: 97px;
            width: parent.width - 55px;
            height: 37px;
            text: root.hero-subtitle;
            font-size: 14px;
            color: #afbecb;
            wrap: word-wrap;
        }
        Rectangle {
            x: 24px; y: 141px; width: 157px; height: 34px;
            border-radius: 7px;
            background: #4de1cb;
            Text {text: "▶  WATCH";color:#08151d;font-weight:800;font-size:13px;
                horizontal-alignment:center;vertical-alignment:center;}
            TouchArea {clicked => {root.play-featured();}}
        }
        Rectangle {
            x: 190px; y: 141px; width: 157px; height: 34px;
            border-width: 1px;border-color:#5b7883;border-radius:7px;background:#223542;
            Text {text: "DETAILS";color:#f7fafc;font-weight:700;font-size:13px;
                horizontal-alignment:center;vertical-alignment:center;}
            TouchArea {clicked => {root.details-featured();}}
        }
        Text {
            x: parent.width - 150px; y: 148px;
            text: "RUST  /  3.0";
            font-size: 11px;
            color: #789baa;
        }
    }
    if !root.details-visible && !root.login-visible: Rectangle {
        x: 26px; y: 289px;
        width: parent.width - 52px;
        height: parent.height - 340px;
        background: transparent;
        Text {
            x: 0px; y: 0px; height: 30px;
            text: root.section-title;
            font-size: 18px;
            font-weight: 800;
            color: #f5f8fb;
        }
        Text {
            x: parent.width - 340px; y: 4px;
            width: 335px;
            text: root.guide-state;
            horizontal-alignment: right;
            color: #4de1cb;
            font-size: 12px;
        }
        VerticalLayout {
            x: 0px; y: 35px;
            width: parent.width;
            height: parent.height - 35px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 11px;
                for media[index] in root.first-row: ShelfTile {
                    horizontal-stretch: 1;
                    media: media;
                    selected: root.selected-index == index;
                    activated => {root.open-item(index);}
                }
            }
            HorizontalLayout {
                spacing: 11px;
                for media[index] in root.second-row: ShelfTile {
                    horizontal-stretch: 1;
                    media: media;
                    selected: root.selected-index == index + 6;
                    activated => {root.open-item(index + 6);}
                }
            }
        }
    }
    if root.details-visible && !root.login-visible: Rectangle {
        x: 26px; y: 94px;
        width: parent.width - 52px;
        height: parent.height - 145px;
        border-radius: 12px;
        background: #152633;
        Text {
            x: 28px; y: 18px;width: parent.width - 60px;height: 50px;
            text: root.details-title;
            font-size: 33px;font-weight: 800;color:#f2f8fa;overflow:elide;
        }
        Text {
            x: 28px;y: 82px;width: parent.width - 60px;height: 165px;
            text: root.details-overview;
            color: #becdd6;font-size: 16px;wrap: word-wrap;
        }
        Text { x:28px;y:257px; text:"CAST";color:#4de1cb;font-size:14px;font-weight:800;}
        Text {
            x: 28px;y:283px;width:parent.width - 60px;height:100px;
            text:root.details-cast;color:#f5f9fb;font-size:14px;wrap:word-wrap;
        }
        Text { x:28px;y:403px;text:"RELATED / AVAILABLE FROM PROVIDER";
            color:#4de1cb;font-size:14px;font-weight:800;}
        Text {
            x:28px;y:432px;width:parent.width - 60px;height:45px;
            text:root.details-related;color:#c3d0dc;font-size:14px;overflow:elide;
        }
        Rectangle {
            x: 28px;y:parent.height - 47px;width:157px;height:37px;
            border-radius:7px;background:#4de1cb;
            Text {text:"▶  PLAY";font-size:14px;font-weight:800;color:#07121a;
                horizontal-alignment:center;vertical-alignment:center;}
            TouchArea {clicked=>{root.play-featured();}}
        }
        Rectangle {
            x: 202px;y:parent.height - 47px;width:154px;height:37px;
            border-radius:7px;background:#2b3b48;
            Text {text:"◀  BACK";font-size:14px;font-weight:700;color:#f4fcff;
                horizontal-alignment:center;vertical-alignment:center;}
            TouchArea {clicked=>{root.go-back();}}
        }
    }
    Rectangle {
        x: 0; y: parent.height - 39px;
        width: parent.width;height:39px;
        background:#0f1c27;
        Text {
            x:27px;y:10px;
            text:root.status-text;
            color:#91aebb;font-size:12px;
        }
        Text {
            x:parent.width - 505px;y:10px;width:480px;
            text:"◀ ▶  Navigate    ▲ ▼  Browse    ●  Select    ◄  Back";
            horizontal-alignment:right;
            color:#7fa2ae;font-size:11px;
        }
    }

    if root.search-visible && !root.login-visible: Rectangle {
        x: 220px;y:137px;
        width:parent.width - 440px;height:180px;
        background:#203440;border-radius:14px;
        border-width:1px;border-color:#4de1cb;
        Text {x:25px;y:19px;text:"SEARCH YOUR IPTV LIBRARY";
            font-size:18px;color:#f7fbff;font-weight:800;}
        search_input := TextInput {
            x:25px;y:66px;width:parent.width - 50px;height:45px;
            text:"";
            color:#f9fbfd;
            background:#101b25;
            font-size:20px;
            accepted => {root.search-library(self.text);root.search-visible=false;}
        }
        Text {x:25px;y:130px;text:"Enter a title, then press Select to search.";
            color:#9eb2c0;font-size:12px;}
    }

    if root.login-visible: Rectangle {
        x: 155px; y: 108px;
        width: parent.width - 310px;
        height: parent.height - 151px;
        background:#132633;
        border-width:1px;border-color:#4c6b78;border-radius:14px;
        Text {
            x:30px;y:21px;
            text:"CONNECT YOUR IPTV PROVIDER";
            font-size:24px;font-weight:800;color:#e8fcfc;
        }
        Text {x:30px;y:61px;text:"XTREAM CODES";font-size:14px;color:#4de1cb;font-weight:800;}
        server_input := TextInput {
            x:30px;y:91px;width:parent.width - 60px;height:38px;
            text:"http://";font-size:16px;color:#f9ffff;background:#091823;
        }
        Text {x:30px;y:140px;text:"USERNAME";font-size:12px;color:#a0bac6;}
        username_input := TextInput {
            x:30px;y:161px;width:parent.width / 2 - 45px;height:38px;
            text:"";font-size:16px;color:#f9ffff;background:#091823;
        }
        Text {x:parent.width / 2 + 4px;y:140px;text:"PASSWORD";font-size:12px;color:#a0bac6;}
        password_input := TextInput {
            x:parent.width / 2 + 4px;y:161px;width:parent.width / 2 - 35px;height:38px;
            text:"";font-size:16px;color:#f9ffff;background:#091823;
        }
        Rectangle {
            x:30px;y:216px;width:200px;height:39px;
            background:#4de1cb;border-radius:7px;
            Text {text:"CONNECT XTREAM";color:#091722;font-size:13px;font-weight:800;
                horizontal-alignment:center;vertical-alignment:center;}
            TouchArea {clicked => {root.connect-xtream(server_input.text,username_input.text,password_input.text);}}
        }
        Rectangle {x:30px;y:281px;width:parent.width - 60px;height:1px;background:#35505e;}
        Text {x:30px;y:298px;text:"OR IMPORT AN M3U PLAYLIST URL";
            font-size:14px;color:#4de1cb;font-weight:800;}
        m3u_input := TextInput {
            x:30px;y:326px;width:parent.width - 60px;height:38px;
            text:"http://";font-size:16px;color:#f9ffff;background:#091823;
        }
        Rectangle {
            x:30px;y:377px;width:200px;height:39px;
            background:#294653;border-radius:7px;
            Text {text:"IMPORT M3U";color:#f9ffff;font-size:13px;font-weight:800;
                horizontal-alignment:center;vertical-alignment:center;}
            TouchArea {clicked => {root.connect-m3u(m3u_input.text);}}
        }
        Text {
            x: 30px;y:442px;width:parent.width - 60px;
            text: "Only add playlists and streams you have permission to access.";
            color:#8a9dab;font-size:13px;
        }
    }

    forward-focus: remote;
    remote := FocusScope {
        x:0; y:0; width:0px; height:0px;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {root.move-selection("left");accept}
            else if (event.text == Key.RightArrow) {root.move-selection("right");accept}
            else if (event.text == Key.UpArrow) {root.move-selection("up");accept}
            else if (event.text == Key.DownArrow) {root.move-selection("down");accept}
            else if (event.text == Key.Return) {root.activate-selection();accept}
            else if (event.text == Key.Escape) {root.go-back();accept}
            else {reject}
        }
    }
}
